# --- DEVELOPMENT (Host-based execution) ---
# Use these when running the Go binary locally on your machine
# DATABASE_URL="postgres://user:password@localhost:5432/dbname"
# PISTON_URL="http://127.0.0.1:2000/api/v2/execute"
# ALLOWED_ORIGINS="http://localhost:5173"

# --- CONTAINER (Docker Compose execution) ---
# Use these when the backend is running inside the Docker network
DATABASE_URL="postgres://meetings_user:meetings_password@db:5432/meetings_db?sslmode=disable"
PISTON_URL="http://piston:2000/api/v2/execute"
ALLOWED_ORIGINS="http://localhost,http://localhost:80"

# --- SHARED ---
JWT_SECRET="generate_a_random_secret_here"
